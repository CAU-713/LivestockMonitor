# -----------------------------------------------------------------
# API Configuration (for backend service)
# -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------
# Database Configuration (used by docker-compose and backend)
# -----------------------------------------------------------------
# These values are used to initialize the PostgreSQL container.
POSTGRES_DB=postgres_db_name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# These values are used by the backend application to connect to the database.
# When using docker-compose, DB_HOST should be the service name of the database container (e.g., 'db').
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_NAME=postgres_db_name
DB_PASSWORD=password

# These values are used by the backend application to connect to the redis cache.
REDIS_HOST=redis
REDIS_PORT=6379

# Secret key for JWT tokens and other cryptographic operations
# Generate a new secret key for production: openssl rand -hex 32
SECRET_KEY=generate_a_new_secret_key_for_production

# -----------------------------------------------------------------
# SSH Tunnel for Database (Optional, for backend service)
# -----------------------------------------------------------------
# Set to "true" to enable connecting to the database via an SSH tunnel.
# Useful for connecting to a remote database that is not publicly accessible.
USE_SSH_TUNNEL=false
# SSH_HOST=your_ssh_host
# SSH_PORT=22
# SSH_USER=your_ssh_user
# SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa


# -----------------------------------------------------------------
# Frontend Configuration (used by frontend service)
# -----------------------------------------------------------------
# The URL the frontend will use to make requests to the backend.
# Examples:
# Development: http://localhost/api
# Production: https://yourdomain.com/api
BACKEND_URL=${PROTOCOL}://${DOMAIN}/api